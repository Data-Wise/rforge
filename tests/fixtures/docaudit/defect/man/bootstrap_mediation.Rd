                           mediator = "M", engine = "lmer",
                           cluster = "school")))
}
result_cluster <- bootstrap_mediation(
  nie_of, method = "nonparametric", data = cdat, cluster = "school",
  n_boot = 20, seed = 1
)
print(result_cluster)
}
